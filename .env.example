# =============================================================================
# RootCause AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure your environment-specific values.
# NEVER commit actual secrets, service-role keys, or database passwords to git.

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
APP_NAME="RootCause AI"
APP_VERSION="1.0.0"
ENVIRONMENT="production"  # "development" | "staging" | "production"
HOST="0.0.0.0"
PORT=8000
FRONTEND_PORT=5173
DEBUG=false
LOG_LEVEL="INFO"          # "DEBUG" | "INFO" | "WARNING" | "ERROR"

# -----------------------------------------------------------------------------
# CORS Allowed Origins
# Comma-separated list or JSON array of allowed frontend origins
# -----------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000"

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# Option A: Direct Connection URI
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"
#
# Option B: Individual Connection Parameters
# -----------------------------------------------------------------------------
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="postgres"
DATABASE_USER="postgres"
DATABASE_PASSWORD="your-secure-password"
DATABASE_CONNECT_TIMEOUT=5

# -----------------------------------------------------------------------------
# LLM Provider Configuration (Optional)
# - If LLM_API_KEY is omitted or blank, RootCause AI automatically uses the
#   built-in deterministic offline fallback rule synthesizer (no external API calls).
# - Option A (OpenAI):
#   LLM_BASE_URL="https://api.openai.com/v1"
#   LLM_MODEL="gpt-4o-mini"
#   LLM_API_KEY="your-openai-api-key"
# - Option B (Google Gemini via OpenAI-Compatible Endpoint):
#   LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
#   LLM_MODEL="gemini-2.0-flash"
#   LLM_API_KEY="your-gemini-api-key"
# -----------------------------------------------------------------------------
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_TIMEOUT_SECONDS=30.0
